#!/usr/bin/env bash
# ==============================================================================
# FenrirOS Driver Manager
#
# Runs as the normal user (so zenity can reach the Wayland/X session) and
# only uses pkexec for the steps that actually need root.
# ==============================================================================

set -uo pipefail

TITLE="FenrirOS Driver Manager"
LOG="${XDG_RUNTIME_DIR:-/tmp}/fenrir-driver-manager.log"

gpus()          { lspci 2>/dev/null | grep -E 'VGA|3D|Display'; }
has_nvidia()    { lspci -d 10de: 2>/dev/null | grep -qE 'VGA|3D|Display'; }
has_amd()       { lspci -d 1002: 2>/dev/null | grep -qE 'VGA|3D|Display'; }
has_intel()     { lspci -d 8086: 2>/dev/null | grep -qE 'VGA|3D|Display'; }

# Run a command as root behind a progress bar. Returns the command's status
# and shows the log on failure instead of always claiming success.
run_root() {
    local text=$1; shift
    : > "$LOG"
    pkexec "$@" >"$LOG" 2>&1 &
    local pid=$!
    (
        while kill -0 "$pid" 2>/dev/null; do
            echo "# $(tail -n1 "$LOG" 2>/dev/null | cut -c1-80)"
            sleep 1
        done
    ) | zenity --progress --title="$TITLE" --text="$text" --pulsate \
        --auto-close --no-cancel --width=500 2>/dev/null
    wait "$pid"
    local rc=$?
    if ((rc != 0 && rc != 2)); then
        zenity --text-info --title="$TITLE - failed" --filename="$LOG" \
            --width=700 --height=400 2>/dev/null
    fi
    return "$rc"
}

manage_nvidia() {
    if ! has_nvidia; then
        zenity --warning --title="$TITLE" --text="No NVIDIA GPU detected." --width=300
        return
    fi

    local choice
    choice=$(zenity --list --title="$TITLE - NVIDIA" \
        --text="Choose a driver. Drivers are prebuilt for your CachyOS kernels." \
        --column="Option" --column="Description" --width=650 --height=280 \
        "auto"   "Recommended driver for this GPU" \
        "open"   "NVIDIA open kernel modules (GTX 16xx / RTX 20xx and newer)" \
        "closed" "NVIDIA proprietary kernel modules" \
        2>/dev/null) || return

    local args=()
    [[ $choice == open ]] && args=(--force-open)
    [[ $choice == closed ]] && args=(--force-closed)

    zenity --question --title="$TITLE" --width=400 \
        --text="This updates the system and installs the NVIDIA driver.\nAn internet connection is required. Continue?" || return

    run_root "Installing NVIDIA driver..." /usr/local/bin/fenrir-nvidia-setup "${args[@]}"
    case $? in
        0) zenity --info --title="$TITLE" --width=300 --text="NVIDIA driver installed. Please reboot." ;;
        2) zenity --warning --title="$TITLE" --width=450 \
               --text="No supported NVIDIA driver package was found for this GPU.\nThe open-source nouveau driver will keep being used." ;;
    esac
}

manage_amd() {
    if ! has_amd; then
        zenity --warning --title="$TITLE" --text="No AMD GPU detected." --width=300
        return
    fi
    zenity --info --title="$TITLE - AMD" --width=450 \
        --text="AMD GPUs use the <b>amdgpu</b> driver built into the kernel, and <b>vulkan-radeon</b> (64- and 32-bit) is already installed.\n\nNo extra drivers are needed."
}

manage_intel() {
    if ! has_intel; then
        zenity --warning --title="$TITLE" --text="No Intel GPU detected." --width=300
        return
    fi
    if pacman -Qq intel-media-driver >/dev/null 2>&1; then
        zenity --info --title="$TITLE - Intel" --width=400 \
            --text="Vulkan and hardware video decoding (intel-media-driver) are already installed."
        return
    fi
    zenity --question --title="$TITLE - Intel" --width=450 \
        --text="Vulkan (vulkan-intel) is already installed.\n\nInstall <b>intel-media-driver</b> for hardware video decoding?" || return
    run_root "Installing intel-media-driver..." pacman -Syu --needed --noconfirm intel-media-driver \
        && zenity --info --title="$TITLE" --width=300 --text="intel-media-driver installed."
}

main() {
    local gpu_list action
    gpu_list=$(gpus)
    [[ -n $gpu_list ]] || gpu_list="(none found)"

    action=$(zenity --list --title="$TITLE" \
        --text="<b>Detected GPU(s):</b>\n${gpu_list}\n\nWhat would you like to do?" \
        --column="Action" --width=650 --height=320 \
        "Manage NVIDIA drivers" "Manage AMD drivers" "Manage Intel drivers" \
        2>/dev/null) || exit 0

    case "$action" in
        "Manage NVIDIA drivers") manage_nvidia ;;
        "Manage AMD drivers")    manage_amd ;;
        "Manage Intel drivers")  manage_intel ;;
    esac
}

main
