#!/usr/bin/env bash
# ==============================================================================
# fenrir-install - Fenrir Linux installer
#
# Guided console installer, in the spirit of archinstall. Installs Fenrir Linux
# fresh from the Artix/Arch/CachyOS repos with basestrap.
#
#   fenrir-install                 ask everything interactively
#   fenrir-install -c answers.conf preset answers (skips those questions)
#
# Example answers file (any variable left out is asked for):
#
#   DISK=/dev/nvme0n1        # or MODE=manual to use what's mounted at /mnt
#   FILESYSTEM=btrfs         # ext4 | btrfs
#   SWAP_GB=8                # 0 = no swap file
#   PROFILE=desktop          # desktop | minimal
#   HOSTNAME=fenrir
#   USERNAME=kyle
#   TIMEZONE=America/Los_Angeles
#   LOCALE=en_US.UTF-8
#   KEYMAP=us
#   NVIDIA=auto              # auto | no
#   CONFIRM=yes              # skip the final "erase disk" confirmation
#
# Passwords are always asked for, never read from the answers file.
# Full log: /var/log/fenrir-install.log (copied to the new system too).
# ==============================================================================

set -Eeuo pipefail

FENRIR_DIR=/usr/share/fenrir
TARGET=/mnt
LOG=/var/log/fenrir-install.log

BOLD=$'\e[1m' RED=$'\e[1;31m' GRN=$'\e[1;32m' YLW=$'\e[1;33m' CYN=$'\e[1;36m' RST=$'\e[0m'

msg()  { printf '%s==>%s %s%s\n' "$GRN" "$RST$BOLD" "$*" "$RST"; }
info() { printf '    %s\n' "$*"; }
warn() { printf '%s==> WARNING:%s %s\n' "$YLW" "$RST" "$*" >&2; }
die()  { printf '%s==> ERROR:%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

on_error() {
    printf '\n%s==> ERROR:%s the install failed at line %s: %s\n' "$RED" "$RST" "$1" "$2" >&2
    printf '    Full log: %s\n' "$LOG" >&2
    printf '    Nothing is unmounted, so you can inspect %s. Run "umount -R %s" before retrying.\n' "$TARGET" "$TARGET" >&2
}
trap 'on_error "$LINENO" "$BASH_COMMAND"' ERR

# ------------------------------------------------------------------------------
# Prompt helpers. Each one skips the question if the variable is already set
# (from an answers file or the environment).
# ------------------------------------------------------------------------------

# ask VAR "Question" [default]
ask() {
    local var=$1 question=$2 default=${3:-} answer
    if [[ -n ${!var:-} ]]; then return; fi
    while true; do
        if [[ -n $default ]]; then
            read -rp "${CYN}?${RST} ${question} [${default}]: " answer
            answer=${answer:-$default}
        else
            read -rp "${CYN}?${RST} ${question}: " answer
        fi
        [[ -n $answer ]] && break
    done
    printf -v "$var" '%s' "$answer"
}

# choose VAR "Question" option1 option2 ...   (first option is the default)
choose() {
    local var=$1 question=$2; shift 2
    local options=("$@") i answer
    if [[ -n ${!var:-} ]]; then return; fi
    echo "${CYN}?${RST} ${question}"
    for i in "${!options[@]}"; do
        printf '    %d) %s\n' "$((i + 1))" "${options[i]}"
    done
    while true; do
        read -rp "    Choice [1]: " answer
        answer=${answer:-1}
        if [[ $answer =~ ^[0-9]+$ ]] && ((answer >= 1 && answer <= ${#options[@]})); then
            printf -v "$var" '%s' "${options[answer - 1]%% *}"
            return
        fi
    done
}

# yes_no "Question" [y|n]  -> exit status
yes_no() {
    local question=$1 default=${2:-y} answer
    read -rp "${CYN}?${RST} ${question} [$([[ $default == y ]] && echo Y/n || echo y/N)]: " answer
    answer=${answer:-$default}
    [[ ${answer,,} == y* ]]
}

# ask_password VAR "Whose"
ask_password() {
    local var=$1 who=$2 p1 p2
    while true; do
        read -rsp "${CYN}?${RST} Password for ${who}: " p1; echo
        read -rsp "${CYN}?${RST} Repeat password: " p2; echo
        if [[ -z $p1 ]]; then
            warn "the password can't be empty"
        elif [[ $p1 != "$p2" ]]; then
            warn "passwords don't match"
        else
            printf -v "$var" '%s' "$p1"
            return
        fi
    done
}

read_pkg_list() {
    # Strip comments and blank lines from a package list file.
    sed -e 's/#.*//' -e 's/[[:space:]]*$//' -e '/^$/d' "$1"
}

part_path() {
    # Nth partition of a disk (handles sda1 and nvme0n1p1 naming).
    lsblk -lnpo NAME,TYPE "$1" | awk '$2 == "part" {print $1}' | sed -n "${2}p"
}

chroot_run() { artix-chroot "$TARGET" "$@"; }

# ------------------------------------------------------------------------------
# Pre-flight
# ------------------------------------------------------------------------------
preflight() {
    [[ $EUID -eq 0 ]] || die "run as root"
    for cmd in basestrap fstabgen artix-chroot sgdisk lsblk; do
        command -v "$cmd" >/dev/null || die "$cmd is missing from the live image"
    done

    if [[ -d /sys/firmware/efi/efivars ]]; then
        BOOT_MODE=uefi
    else
        BOOT_MODE=bios
    fi
    msg "Boot mode: ${BOOT_MODE^^}"

    msg "Checking the internet connection"
    until curl -fsS --max-time 10 -o /dev/null https://mirrors.dotsrc.org/artix-linux/; do
        warn "no internet connection"
        info "Ethernet should connect by itself. For Wi-Fi, use nmtui."
        yes_no "Open nmtui now?" y && nmtui || true
        yes_no "Try again?" y || die "an internet connection is required"
    done

    msg "Preparing the package keyring"
    if [[ ! -s /etc/pacman.d/gnupg/pubring.gpg && ! -s /etc/pacman.d/gnupg/pubring.kbx ]]; then
        pacman-key --init
        pacman-key --populate artix archlinux cachyos
    fi
    pacman -Sy --noconfirm
    # The ISO's keyrings may be older than the packages on the mirrors.
    pacman -S --needed --noconfirm artix-keyring archlinux-keyring cachyos-keyring
}

# ------------------------------------------------------------------------------
# Questions
# ------------------------------------------------------------------------------
ask_disk() {
    if [[ ${MODE:-} == manual || -n ${DISK:-} ]]; then
        MODE=${MODE:-auto}
        return
    fi

    msg "Disks"
    lsblk -dno NAME,SIZE,MODEL,TYPE | awk '$NF == "disk"' | sed 's/ disk$//' | sed 's/^/    /'
    echo

    local disks=() line
    while read -r line; do disks+=("$line"); done < <(lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF == "disk" {$NF=""; print}' | grep -v '/dev/loop')
    disks+=("manual - use the partitions I already mounted at ${TARGET}")

    local choice
    choose choice "Install to which disk? The whole disk will be ERASED." "${disks[@]}"
    if [[ $choice == manual ]]; then
        MODE=manual
    else
        MODE=auto
        DISK=$choice
    fi
}

ask_everything() {
    ask_disk
    if [[ $MODE == auto ]]; then
        [[ -b $DISK ]] || die "$DISK is not a block device"
        choose FILESYSTEM "Filesystem for the system partition?" \
            "btrfs - snapshots-ready, transparent compression" \
            "ext4  - simple and proven"
        local ram_gb
        ram_gb=$(awk '/MemTotal/ {printf "%d", ($2 / 1048576) + 0.5}' /proc/meminfo)
        ask SWAP_GB "Swap file size in GB (0 = none)" "$(( ram_gb < 8 ? ram_gb : 8 ))"
        [[ $SWAP_GB =~ ^[0-9]+$ ]] || die "swap size must be a number"
    else
        mountpoint -q "$TARGET" || die "nothing is mounted at ${TARGET}"
        if [[ $BOOT_MODE == uefi ]]; then
            find_esp >/dev/null || die "UEFI install: mount your EFI system partition (FAT32) at ${TARGET}/boot/efi first"
        fi
        if [[ $BOOT_MODE == bios ]]; then
            ask DISK "Disk to install GRUB to (e.g. /dev/sda)"
            [[ -b $DISK ]] || die "$DISK is not a block device"
        fi
    fi

    choose PROFILE "What should be installed?" \
        "desktop - KDE Plasma, Steam, Lutris, gaming tools" \
        "minimal - console only, add what you want later"

    ask HOSTNAME "Computer name (hostname)" "fenrir"
    [[ $HOSTNAME =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] || die "invalid hostname: $HOSTNAME"

    ask USERNAME "Your username"
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "invalid username (lowercase letters, digits, - and _): $USERNAME"
    [[ $USERNAME != root ]] || die "pick a username other than root"
    ask_password USER_PASSWORD "$USERNAME"

    while true; do
        ask TIMEZONE "Time zone (Region/City)" "$(curl -fsS --max-time 5 https://ipapi.co/timezone 2>/dev/null || echo UTC)"
        [[ -f /usr/share/zoneinfo/$TIMEZONE ]] && break
        warn "unknown time zone: $TIMEZONE (examples: Europe/Berlin, America/New_York)"
        TIMEZONE=""
    done

    while true; do
        ask LOCALE "Language / locale" "en_US.UTF-8"
        grep -q "^${LOCALE} " /usr/share/i18n/SUPPORTED && break
        warn "unknown locale: $LOCALE (examples: en_US.UTF-8, de_DE.UTF-8)"
        LOCALE=""
    done

    while true; do
        ask KEYMAP "Console keyboard layout" "us"
        find /usr/share/kbd/keymaps -name "${KEYMAP}.map.gz" | grep -q . && break
        warn "unknown keyboard layout: $KEYMAP (examples: us, de, uk, fr)"
        KEYMAP=""
    done

    NVIDIA=${NVIDIA:-auto}
    if [[ $NVIDIA == auto ]] && lspci -d 10de: 2>/dev/null | grep -qE 'VGA|3D|Display'; then
        HAS_NVIDIA=1
    else
        HAS_NVIDIA=0
    fi
}

summary() {
    echo
    msg "Summary"
    if [[ $MODE == auto ]]; then
        info "Disk:        ${DISK} (ERASED)  $(lsblk -dno SIZE,MODEL "$DISK" | xargs)"
        info "Filesystem:  ${FILESYSTEM}, swap file ${SWAP_GB} GB"
    else
        info "Disk:        use what's mounted at ${TARGET}"
        [[ $BOOT_MODE == bios ]] && info "GRUB disk:   ${DISK}"
    fi
    info "Boot mode:   ${BOOT_MODE^^}"
    info "Profile:     ${PROFILE}"
    info "Hostname:    ${HOSTNAME}"
    info "User:        ${USERNAME} (admin via sudo, root login disabled)"
    info "Time zone:   ${TIMEZONE}"
    info "Locale:      ${LOCALE}, keyboard ${KEYMAP}"
    ((HAS_NVIDIA)) && info "NVIDIA:      GPU found, driver will be installed"
    echo

    if [[ ${CONFIRM:-} == yes ]]; then return; fi
    if [[ $MODE == auto ]]; then
        local answer
        read -rp "${RED}Type ERASE to wipe ${DISK} and install:${RST} " answer
        [[ $answer == ERASE ]] || die "cancelled, nothing was changed"
    else
        yes_no "Install now?" n || die "cancelled, nothing was changed"
    fi
}

# ------------------------------------------------------------------------------
# Disk
# ------------------------------------------------------------------------------
partition_and_mount() {
    [[ $MODE == auto ]] || return 0

    msg "Partitioning ${DISK}"
    swapoff -a || true
    umount -R "$TARGET" 2>/dev/null || true
    wipefs -af "$DISK"
    sgdisk --zap-all "$DISK"
    if [[ $BOOT_MODE == uefi ]]; then
        sgdisk -n1:0:+1G -t1:ef00 -c1:EFI -n2:0:0 -t2:8300 -c2:FenrirLinux "$DISK"
    else
        # GPT on BIOS needs a tiny BIOS boot partition for GRUB.
        sgdisk -n1:0:+1M -t1:ef02 -c1:BIOSBOOT -n2:0:0 -t2:8300 -c2:FenrirLinux "$DISK"
    fi
    partprobe "$DISK" 2>/dev/null || true
    udevadm settle
    sleep 1

    local p1 p2
    p1=$(part_path "$DISK" 1)
    p2=$(part_path "$DISK" 2)
    [[ -b $p1 && -b $p2 ]] || die "could not find the new partitions on $DISK"

    msg "Formatting"
    [[ $BOOT_MODE == uefi ]] && mkfs.fat -F 32 -n EFI "$p1"
    if [[ $FILESYSTEM == btrfs ]]; then
        mkfs.btrfs -f -L FenrirLinux "$p2"
        mount "$p2" "$TARGET"
        btrfs subvolume create "$TARGET/@"
        btrfs subvolume create "$TARGET/@home"
        btrfs subvolume create "$TARGET/@swap"
        umount "$TARGET"
        local opts=noatime,compress=zstd:1
        mount -o "subvol=@,$opts" "$p2" "$TARGET"
        mkdir -p "$TARGET/home" "$TARGET/swap"
        mount -o "subvol=@home,$opts" "$p2" "$TARGET/home"
        mount -o "subvol=@swap,noatime" "$p2" "$TARGET/swap"
    else
        mkfs.ext4 -F -L FenrirLinux "$p2"
        mount -o noatime "$p2" "$TARGET"
    fi

    if [[ $BOOT_MODE == uefi ]]; then
        mkdir -p "$TARGET/boot/efi"
        mount "$p1" "$TARGET/boot/efi"
    fi

    if ((SWAP_GB > 0)); then
        msg "Creating a ${SWAP_GB} GB swap file"
        if [[ $FILESYSTEM == btrfs ]]; then
            btrfs filesystem mkswapfile --size "${SWAP_GB}g" "$TARGET/swap/swapfile"
            swapon "$TARGET/swap/swapfile"
        else
            fallocate -l "${SWAP_GB}G" "$TARGET/swapfile"
            chmod 600 "$TARGET/swapfile"
            mkswap "$TARGET/swapfile"
            swapon "$TARGET/swapfile"
        fi
    fi
}

find_esp() {
    local d
    for d in /boot/efi /efi /boot; do
        if mountpoint -q "${TARGET}${d}" && [[ $(findmnt -no FSTYPE "${TARGET}${d}") == vfat ]]; then
            echo "$d"
            return 0
        fi
    done
    return 1
}

# ------------------------------------------------------------------------------
# Install
# ------------------------------------------------------------------------------
install_packages() {
    local pkgs=()
    mapfile -t pkgs < <(read_pkg_list "$FENRIR_DIR/packages/base.txt")
    if [[ $PROFILE == desktop ]]; then
        mapfile -t -O "${#pkgs[@]}" pkgs < <(read_pkg_list "$FENRIR_DIR/packages/desktop.txt")
    fi

    msg "Installing ${#pkgs[@]} packages (this downloads a few GB on the desktop profile)"
    # -G: don't copy the live keyring, the new system gets its own below.
    basestrap -G "$TARGET" "${pkgs[@]}"

    msg "Writing /etc/fstab"
    fstabgen -U "$TARGET" >> "$TARGET/etc/fstab"
}

copy_fenrir_files() {
    msg "Adding Fenrir Linux files"
    cp -a "$FENRIR_DIR/rootfs/." "$TARGET/"
    install -m644 /etc/pacman.conf "$TARGET/etc/pacman.conf"
    if [[ $PROFILE != desktop ]]; then
        # Desktop-only bits are pointless on a console install.
        rm -f "$TARGET/etc/xdg/autostart/fenrir-pipewire.desktop" \
              "$TARGET"/usr/share/applications/fenrir-*.desktop
        rm -rf "$TARGET/usr/lib/firefox"
    fi
}

configure_system() {
    msg "Configuring the system"

    # Time
    ln -sf "/usr/share/zoneinfo/${TIMEZONE}" "$TARGET/etc/localtime"
    chroot_run hwclock --systohc

    # Locale
    sed -i "s/^#\(${LOCALE//./\\.} \)/\1/" "$TARGET/etc/locale.gen"
    grep -q "^en_US.UTF-8 " "$TARGET/etc/locale.gen" || sed -i 's/^#\(en_US\.UTF-8 \)/\1/' "$TARGET/etc/locale.gen"
    chroot_run locale-gen
    echo "LANG=${LOCALE}" > "$TARGET/etc/locale.conf"

    # Keyboard (console)
    echo "KEYMAP=${KEYMAP}" > "$TARGET/etc/vconsole.conf"
    if [[ -f $TARGET/etc/conf.d/keymaps ]]; then
        sed -i "s/^keymap=.*/keymap=\"${KEYMAP}\"/" "$TARGET/etc/conf.d/keymaps"
    fi

    # Hostname (OpenRC reads /etc/conf.d/hostname)
    echo "$HOSTNAME" > "$TARGET/etc/hostname"
    echo "hostname=\"${HOSTNAME}\"" > "$TARGET/etc/conf.d/hostname"
    cat > "$TARGET/etc/hosts" <<EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${HOSTNAME}.localdomain ${HOSTNAME}
EOF

    # Branding
    chroot_run /usr/local/bin/fenrir-os-release

    # Pacman keyring for the new system
    msg "Setting up the package keyring"
    chroot_run pacman-key --init
    chroot_run pacman-key --populate artix archlinux cachyos
    chroot_run gpgconf --homedir /etc/pacman.d/gnupg --kill all || true
}

create_user() {
    msg "Creating user ${USERNAME}"
    chroot_run groupadd -f -r gamemode
    local groups=wheel,audio,video,storage,optical,input,network,gamemode
    chroot_run useradd -m -G "$groups" -s /bin/bash "$USERNAME"
    printf '%s:%s\n' "$USERNAME" "$USER_PASSWORD" | chroot_run chpasswd
    unset USER_PASSWORD

    install -Dm440 /dev/stdin "$TARGET/etc/sudoers.d/10-wheel" <<'EOF'
# Members of wheel can run commands as root after entering their password.
%wheel ALL=(ALL:ALL) ALL
EOF
    chroot_run passwd -l root >/dev/null
}

enable_services() {
    msg "Enabling services"
    local svc runlevel
    local services=(
        "udev:sysinit" "dbus:default" "elogind:default" "NetworkManager:default"
        "chronyd:default" "cronie:default" "acpid:default" "scx:default"
    )
    if [[ $PROFILE == desktop ]]; then
        services+=("bluetoothd:default" "sddm:default")
    fi
    for entry in "${services[@]}"; do
        svc=${entry%%:*}
        runlevel=${entry#*:}
        if [[ -e $TARGET/etc/init.d/$svc ]]; then
            chroot_run rc-update add "$svc" "$runlevel" >/dev/null 2>&1 || true
            info "enabled ${svc}"
        else
            warn "service ${svc} not found, skipped"
        fi
    done
}

setup_nvidia() {
    ((HAS_NVIDIA)) || return 0
    msg "Installing the NVIDIA driver"
    chroot_run /usr/local/bin/fenrir-nvidia-setup --no-rebuild \
        || warn "NVIDIA setup failed; run 'Fenrir Linux Driver Manager' after the first boot"
}

install_bootloader() {
    msg "Building the initramfs"
    chroot_run mkinitcpio -P

    msg "Installing GRUB"
    sed -i -E 's/^#?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' "$TARGET/etc/default/grub"
    grep -q '^GRUB_DISABLE_OS_PROBER=' "$TARGET/etc/default/grub" \
        || echo 'GRUB_DISABLE_OS_PROBER=false' >> "$TARGET/etc/default/grub"
    sed -i -E 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Fenrir Linux"/' "$TARGET/etc/default/grub"

    if [[ $BOOT_MODE == uefi ]]; then
        local esp
        esp=$(find_esp) || die "no EFI system partition mounted at ${TARGET}/boot/efi"
        if ! chroot_run grub-install --target=x86_64-efi --efi-directory="$esp" --bootloader-id=FenrirLinux --recheck; then
            warn "could not add a UEFI boot entry, installing without NVRAM"
            chroot_run grub-install --target=x86_64-efi --efi-directory="$esp" --bootloader-id=FenrirLinux --no-nvram
        fi
        # Fallback path EFI/BOOT/BOOTX64.EFI for boards that drop NVRAM entries.
        chroot_run grub-install --target=x86_64-efi --efi-directory="$esp" --removable \
            || warn "could not install the EFI fallback loader"
    else
        chroot_run grub-install --target=i386-pc --recheck "$DISK"
    fi
    chroot_run grub-mkconfig -o /boot/grub/grub.cfg
}

finish() {
    msg "Finishing up"
    install -Dm600 "$LOG" "$TARGET/var/log/fenrir-install.log"
    sync
    swapoff -a || true
    umount -R "$TARGET"

    echo
    printf '%s  Fenrir Linux is installed. Welcome to the pack.%s\n' "$GRN" "$RST"
    info "Remove the USB stick and reboot. Log in as ${USERNAME}."
    echo
    yes_no "Reboot now?" y && reboot
}

# ------------------------------------------------------------------------------
main() {
    while getopts ":c:h" opt; do
        case $opt in
            c) [[ -f $OPTARG ]] || die "answers file not found: $OPTARG"
               # shellcheck source=/dev/null
               source "$OPTARG" ;;
            h) sed -n '2,30p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
            *) die "usage: fenrir-install [-c answers.conf]" ;;
        esac
    done

    clear
    printf '%s\n  Fenrir Linux installer\n  Gaming Linux, unchained from systemd%s\n\n' "$BOLD" "$RST"

    preflight
    ask_everything
    summary

    # From here on, log everything (passwords are never echoed).
    exec > >(tee -a "$LOG") 2>&1

    partition_and_mount
    install_packages
    copy_fenrir_files
    configure_system
    create_user
    enable_services
    setup_nvidia
    install_bootloader
    finish
}

main "$@"
