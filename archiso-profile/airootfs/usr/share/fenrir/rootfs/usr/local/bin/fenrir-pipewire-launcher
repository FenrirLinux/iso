#!/bin/sh
# Fenrir Linux - start PipeWire for the desktop session.
#
# OpenRC has no user services, so nothing would start PipeWire on login.
# This is started once per session by /etc/xdg/autostart/fenrir-pipewire.desktop
# and starts the three daemons in the right order:
#   pipewire -> wireplumber (session manager) + pipewire-pulse (PulseAudio
#   compatibility, needed by Steam, Discord, browsers and most apps).
#
# Run "fenrir-pipewire-launcher" again from a terminal to restart audio.

uid=$(id -u)

# Stop anything left over (re-login, manual restart).
pkill -u "$uid" -x pipewire-pulse 2>/dev/null
pkill -u "$uid" -x wireplumber 2>/dev/null
pkill -u "$uid" -x pipewire 2>/dev/null
sleep 1

/usr/bin/pipewire &

# Wait (up to 5s) for the PipeWire socket before starting its clients.
runtime="${XDG_RUNTIME_DIR:-/run/user/$uid}"
i=0
while [ ! -S "$runtime/pipewire-0" ] && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done

/usr/bin/wireplumber &
/usr/bin/pipewire-pulse &

wait
