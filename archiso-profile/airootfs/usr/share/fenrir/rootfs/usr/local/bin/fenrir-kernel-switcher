#!/usr/bin/env bash
# ==============================================================================
# Fenrir Linux Kernel Switcher
#
# GUI mode (no arguments, normal user): pick which CachyOS kernels should be
# installed. Kernels you check are installed, kernels you uncheck are removed.
#
# Apply mode (run as root through pkexec):
#   fenrir-kernel-switcher --apply "<kernels to install>" "<kernels to remove>"
# ==============================================================================

set -uo pipefail

TITLE="Fenrir Linux Kernel Switcher"
LOG="${XDG_RUNTIME_DIR:-/tmp}/fenrir-kernel-switcher.log"

# pkgbase|description. Only the ones the repos actually carry are shown.
KERNELS=(
    "linux-cachyos|CachyOS default kernel (recommended)"
    "linux-cachyos-lts|Long-term support kernel, a stable fallback"
    "linux-cachyos-bore|BORE scheduler, tuned for desktop responsiveness"
    "linux-cachyos-eevdf|Mainline EEVDF scheduler with CachyOS patches"
    "linux-cachyos-rt-bore|Real-time kernel with BORE (audio production)"
    "linux-cachyos-deckify|Handheld / Steam Deck style devices"
    "linux-cachyos-hardened|Security-hardened kernel"
    "linux-cachyos-server|Server-tuned kernel"
)

# ------------------------------------------------------------------------------
# Apply mode (root)
# ------------------------------------------------------------------------------
nvidia_suffix() {
    # Which NVIDIA module flavour the running system uses, if any.
    if pacman -Qq 2>/dev/null | grep -q -- '-nvidia-open$'; then echo "-nvidia-open"
    elif pacman -Qq 2>/dev/null | grep -q -- '-nvidia$'; then echo "-nvidia"
    fi
}

apply_changes() {
    local -a install remove pkgs=()
    read -ra install <<< "${1:-}"
    read -ra remove <<< "${2:-}"
    local suffix k
    suffix=$(nvidia_suffix)

    if ((${#install[@]})); then
        for k in "${install[@]}"; do
            # No -headers: they need a newer pahole than Artix ships, and
            # Fenrir uses prebuilt modules instead of DKMS.
            pkgs+=("$k")
            [[ -n $suffix ]] && pkgs+=("${k}${suffix}")
        done
        echo "Installing: ${pkgs[*]}"
        pacman -Syu --needed --noconfirm "${pkgs[@]}" || exit 1
    fi

    if ((${#remove[@]})); then
        pkgs=()
        for k in "${remove[@]}"; do
            pkgs+=("$k")
            pacman -Qq "${k}-headers" >/dev/null 2>&1 && pkgs+=("${k}-headers")
            [[ -n $suffix ]] && pacman -Qq "${k}${suffix}" >/dev/null 2>&1 && pkgs+=("${k}${suffix}")
        done
        echo "Removing: ${pkgs[*]}"
        pacman -Rns --noconfirm "${pkgs[@]}" || exit 1
    fi

    echo "Updating GRUB menu"
    grub-mkconfig -o /boot/grub/grub.cfg || exit 1
}

if [[ ${1:-} == --apply ]]; then
    [[ $EUID -eq 0 ]] || { echo "--apply must run as root" >&2; exit 1; }
    apply_changes "${2:-}" "${3:-}"
    exit $?
fi

# ------------------------------------------------------------------------------
# GUI mode (user)
# ------------------------------------------------------------------------------
installed() { pacman -Qq "$1" >/dev/null 2>&1; }

main() {
    local available entry pkg desc
    available=$(pacman -Slq 2>/dev/null)

    local -a rows=() known=()
    for entry in "${KERNELS[@]}"; do
        pkg=${entry%%|*}
        desc=${entry#*|}
        if installed "$pkg"; then
            rows+=(TRUE "$pkg" "$desc (installed)")
        elif grep -qx -- "$pkg" <<< "$available"; then
            rows+=(FALSE "$pkg" "$desc")
        else
            continue
        fi
        known+=("$pkg")
    done

    local choice
    while true; do
        choice=$(zenity --list --checklist --title="$TITLE" \
            --text="Checked kernels will be installed, unchecked ones removed.\n<b>At least one kernel must stay installed.</b>" \
            --column="Installed" --column="Package" --column="Description" \
            --separator=" " --width=760 --height=400 \
            "${rows[@]}" 2>/dev/null) || exit 0
        [[ -n $choice ]] && break
        zenity --warning --title="$TITLE" --width=300 --text="Select at least one kernel."
    done

    local -a to_install=() to_remove=()
    for pkg in "${known[@]}"; do
        if tr ' ' '\n' <<< "$choice" | grep -qx -- "$pkg"; then
            installed "$pkg" || to_install+=("$pkg")
        else
            installed "$pkg" && to_remove+=("$pkg")
        fi
    done

    if ((${#to_install[@]} == 0 && ${#to_remove[@]} == 0)); then
        zenity --info --title="$TITLE" --width=300 --text="Nothing to change."
        exit 0
    fi

    zenity --question --title="$TITLE" --width=450 \
        --text="Install: ${to_install[*]:-none}\nRemove: ${to_remove[*]:-none}\n\nApply these changes?" \
        2>/dev/null || exit 0

    : > "$LOG"
    pkexec "$0" --apply "${to_install[*]}" "${to_remove[*]}" >"$LOG" 2>&1 &
    local pid=$!
    (
        while kill -0 "$pid" 2>/dev/null; do
            echo "# $(tail -n1 "$LOG" 2>/dev/null | cut -c1-80)"
            sleep 1
        done
    ) | zenity --progress --title="$TITLE" --text="Applying kernel changes..." \
        --pulsate --auto-close --no-cancel --width=500 2>/dev/null

    if wait "$pid"; then
        zenity --info --title="$TITLE" --width=350 \
            --text="Kernel changes applied.\nReboot and pick the kernel from the GRUB menu."
    else
        zenity --text-info --title="$TITLE - failed" --filename="$LOG" \
            --width=700 --height=400 2>/dev/null
    fi
}

main
