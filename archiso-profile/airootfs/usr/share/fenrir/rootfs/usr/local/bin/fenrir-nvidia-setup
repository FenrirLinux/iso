#!/usr/bin/env bash
# ==============================================================================
# Fenrir Linux NVIDIA setup
#
# Installs NVIDIA drivers for every installed CachyOS kernel, using CachyOS's
# prebuilt module packages (<kernel>-nvidia-open / <kernel>-nvidia) so nothing
# has to be compiled with DKMS.
#
# Usage: fenrir-nvidia-setup [--no-rebuild] [--force-open|--force-closed]
#   --no-rebuild    don't run mkinitcpio afterwards (fenrir-install does it)
#
# Exit codes: 0 = installed or nothing to do, 1 = failed, 2 = unsupported GPU
# Needs root and a network connection.
# ==============================================================================

set -uo pipefail

log()  { echo "[NVIDIA] $*"; }
warn() { echo "[NVIDIA] WARNING: $*" >&2; }

REBUILD=1
FORCE=""
for arg in "$@"; do
    case "$arg" in
        --no-rebuild)   REBUILD=0 ;;
        --force-open)   FORCE=open ;;
        --force-closed) FORCE=closed ;;
        *) echo "unknown option: $arg" >&2; exit 1 ;;
    esac
done

[[ $EUID -eq 0 ]] || { echo "must run as root" >&2; exit 1; }
command -v lspci >/dev/null || { warn "lspci not found (install pciutils)"; exit 1; }

# PCI device id of the first NVIDIA display controller (class 03xx), e.g. 2684
nvidia_device_id() {
    lspci -nn -d 10de: 2>/dev/null \
        | grep -E '\[03[0-9a-f]{2}\]' \
        | grep -oE '\[10de:[0-9a-f]{4}\]' \
        | head -n1 | cut -d: -f2 | tr -d ']'
}

installed_kernels() {
    local f
    for f in /usr/lib/modules/*/pkgbase; do
        [[ -r $f ]] && cat "$f"
    done
}

repo_has() { pacman -Si "$1" >/dev/null 2>&1; }

main() {
    local dev_id flavour
    dev_id=$(nvidia_device_id)
    if [[ -z $dev_id ]]; then
        log "No NVIDIA GPU detected, nothing to do"
        exit 0
    fi
    log "NVIDIA GPU detected: $(lspci -d 10de: | grep -E 'VGA|3D|Display' | head -n1)"

    # Turing (GTX 16xx / RTX 20xx) and newer have device ids from 0x1e00 up
    # and use NVIDIA's open kernel modules. Current NVIDIA drivers no longer
    # support older generations, so those get the closed module only if the
    # repo still carries one.
    if [[ -n $FORCE ]]; then
        flavour=$FORCE
    elif (( 16#$dev_id >= 16#1e00 )); then
        flavour=open
    else
        flavour=closed
    fi
    log "Driver flavour: ${flavour}"

    log "Syncing package databases"
    pacman -Sy --noconfirm || { warn "could not reach the package mirrors (no network?)"; exit 1; }

    local kernels pkgs=() k mod
    mapfile -t kernels < <(installed_kernels)
    for k in "${kernels[@]}"; do
        if [[ $flavour == open ]]; then mod="${k}-nvidia-open"; else mod="${k}-nvidia"; fi
        if repo_has "$mod"; then
            pkgs+=("$mod")
        else
            warn "no prebuilt module package ${mod} for kernel ${k}"
        fi
    done

    if ((${#pkgs[@]} == 0)); then
        if [[ $flavour == closed ]]; then
            warn "This GPU is older than Turing and no supported driver package was found."
            warn "The open-source nouveau driver (already included) will be used."
            exit 2
        fi
        exit 1
    fi
    pkgs+=(nvidia-utils lib32-nvidia-utils)

    # -Syu together with the install: the module packages are built against
    # an exact kernel version, and Arch-style repos don't support partial
    # upgrades, so bring the whole system up to date in the same transaction.
    log "Installing: ${pkgs[*]}"
    pacman -Syu --needed --noconfirm "${pkgs[@]}" || { warn "package installation failed"; exit 1; }

    # Early KMS: load the NVIDIA modules from the initramfs.
    if [[ -f /etc/mkinitcpio.conf ]] && ! grep -qE '^MODULES=.*nvidia' /etc/mkinitcpio.conf; then
        sed -i -E 's/^MODULES=\((.*)\)/MODULES=(\1 nvidia nvidia_modeset nvidia_uvm nvidia_drm)/; s/^MODULES=\( /MODULES=(/' /etc/mkinitcpio.conf
    fi

    # Needed for Wayland (KWin) on NVIDIA.
    install -Dm644 /dev/stdin /etc/modprobe.d/fenrir-nvidia.conf <<'EOF'
# Fenrir Linux - NVIDIA DRM kernel modesetting (required for Wayland)
options nvidia_drm modeset=1 fbdev=1
EOF

    if ((REBUILD)); then
        log "Rebuilding initramfs"
        mkinitcpio -P || { warn "mkinitcpio failed"; exit 1; }
    fi

    log "NVIDIA driver installed. Reboot to use it."
}

main
