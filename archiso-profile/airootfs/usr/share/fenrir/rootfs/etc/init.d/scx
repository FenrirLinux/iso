#!/sbin/openrc-run
# Fenrir Linux - run a sched_ext scheduler under OpenRC.
# scx ships only systemd units, so this replaces scx.service/scx_loader.

description="sched_ext BPF CPU scheduler"
supervisor=supervise-daemon
command="/usr/bin/${SCX_SCHEDULER:-scx_lavd}"
command_args="${SCX_FLAGS}"
respawn_delay=5
respawn_max=3

depend() {
    after localmount
}

start_pre() {
    if [ ! -d /sys/kernel/sched_ext ]; then
        eerror "This kernel has no sched_ext support; use a linux-cachyos kernel."
        return 1
    fi
    if [ ! -x "${command}" ]; then
        eerror "${command} not found (is scx-scheds installed?)"
        return 1
    fi
}
