#!/bin/bash
# mkinitcpio install script for the fenrir-udev hook

build() {
    add_binary /usr/bin/udevd
    add_binary /usr/bin/udevadm
    add_binary kill

    add_full_dir /usr/lib/udev

    add_runscript
}

help() {
    cat <<HELPEOF
Fenrir Linux udev hook - starts Artix udevd in the initramfs, and on the live
ISO waits for the boot medium to appear.
HELPEOF
}
