#!/usr/bin/ash
# FenrirOS udev hook for mkinitcpio (Artix eudev/udev, no systemd).

run_earlyhook() {
    /usr/bin/udevd --daemon --resolve-names=never
}

run_hook() {
    msg ":: Triggering uevents..."
    udevadm trigger --action=add --type=subsystems
    udevadm trigger --action=add --type=devices
    udevadm settle --timeout=10

    # Live ISO only: slow USB sticks can show up after udev settles, so wait
    # up to 15s for the ISO label taken from the kernel command line.
    # Installed systems don't pass archisolabel= and skip this entirely.
    local arg label="" i=0
    for arg in $(cat /proc/cmdline); do
        case "$arg" in
            archisolabel=*) label="${arg#archisolabel=}" ;;
        esac
    done
    [ -n "$label" ] || return 0

    while [ "$i" -lt 15 ] && [ ! -e "/dev/disk/by-label/${label}" ]; do
        sleep 1
        i=$((i + 1))
    done
}

run_cleanuphook() {
    udevadm control --exit
    udevadm info --cleanup-db
}
