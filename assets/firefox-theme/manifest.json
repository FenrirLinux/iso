{
  "manifest_version": 2,
  "name": "Fenrir Browser Theme",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": {
      "id": "fenrir-theme@fenrirlinux.org"
    }
  },
  "theme": {
    "colors": {
      "toolbar": "#0f151d",
      "toolbar_text": "#e6edf3",
      "frame": "#0a0e14",
      "tab_text": "#e6edf3",
      "tab_line": "#28d2f5",
      "tab_loading": "#28d2f5",
      "tab_selected": "#0f151d",
      "tab_background_text": "#8fa0b2",
      "bookmark_text": "#e6edf3",
      "toolbar_field": "#151d28",
      "toolbar_field_text": "#e6edf3",
      "toolbar_field_border": "#1d2733",
      "toolbar_field_focus": "#151d28",
      "toolbar_field_text_focus": "#e6edf3",
      "toolbar_field_border_focus": "#28d2f5",
      "toolbar_top_separator": "#0a0e14",
      "toolbar_bottom_separator": "#1d2733",
      "toolbar_vertical_separator": "#1d2733",
      "icons": "#28d2f5",
      "icons_attention": "#7fe6fb",
      "button_background_active": "#1d2733",
      "button_background_hover": "#151d28",
      "popup": "#0f151d",
      "popup_text": "#e6edf3",
      "popup_border": "#1d2733",
      "popup_highlight": "#28d2f5",
      "popup_highlight_text": "#0a0e14",
      "sidebar": "#0f151d",
      "sidebar_text": "#e6edf3",
      "sidebar_highlight": "#28d2f5",
      "sidebar_highlight_text": "#0a0e14",
      "sidebar_border": "#1d2733",
      "ntp_background": "#0a0e14",
      "ntp_text": "#e6edf3"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "dark"
    }
  }
}
